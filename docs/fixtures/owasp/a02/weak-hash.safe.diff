diff --git a/app/Services/SignatureService.php b/app/Services/SignatureService.php
--- a/app/Services/SignatureService.php
+++ b/app/Services/SignatureService.php
@@ -0,0 +1,8 @@
+<?php
+
+class SignatureService
+{
+    public function fingerprint(string $value): string { return hash('sha256', $value); }
+    public function token(string $value): string { return password_hash($value, PASSWORD_ARGON2ID); }
+}
